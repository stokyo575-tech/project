# Environment Configuration Template
# Copy to .env.local and customize for your environment

# Backend API Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_API_TIMEOUT=5000

# Feature Flags
REACT_APP_ENABLE_LOGGING=true
REACT_APP_LOG_LEVEL=debug
REACT_APP_ENABLE_THINKING=true

# GitHub Pages Configuration
HOMEPAGE=https://username.github.io/RianModss-main

# API Keys (Optional)
# REACT_APP_GEMINI_KEY=your_api_key_here
# REACT_APP_API_SECRET=your_secret_here

# Authentication (Optional)
REACT_APP_AUTH_ENABLED=true
REACT_APP_JWT_SECRET=your_jwt_secret_here

# Analytics (Optional)
REACT_APP_ANALYTICS_ID=UA-XXXXXXXXX-X

# Environment
NODE_ENV=development
